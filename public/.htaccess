# Hostinger shared hosting — SPA (React Router)
# إن ظهرت صفحة "This Page Does Not Exist" من Hostinger:
# hPanel → Advanced → Error Pages → 404 → اختر الملف index.html من موقعك (أو Default إن وُجد 404.html)

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L,QSA]
</IfModule>

# عند تفعيل Error Pages الافتراضية في Hostinger يُفضَّل index.html ليبقى المسار في شريط العنوان
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html
