VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ELEVENLABS_API_KEY=your-elevenlabs-key
VITE_ELEVENLABS_VOICE_ID=your-arabic-voice-id

# رفع ملفات على Hostinger (الملف على الاستضافة + الرابط في Supabase فقط)
# اترك الروابط فارغة لاستخدام /api/*.php على نفس النطاق
VITE_HOSTINGER_UPLOAD_URL=
VITE_HOSTINGER_EVIDENCE_UPLOAD_URL=
VITE_HOSTINGER_MEDIA_UPLOAD_URL=
VITE_HOSTINGER_UPLOAD_TOKEN=CHANGE_ME_TEACHER_UPLOAD_TOKEN
# يجب أن يطابق UPLOAD_TOKEN في:
# public/api/upload-exam-review.php
# public/api/upload-points-evidence.php
# public/api/upload-school-media.php

# Google login: فعّل المزود من Supabase Dashboard → Authentication → Providers → Google
# (Client ID / Client Secret من Google Cloud Console — لا تُوضع في .env للواجهة)
cd "/mnt/E/school_management_new/ERB Elite"

# الصق مفتاح OpenRouter هنا (الذي يبدأ بـ sk-or-v1-...)
/tmp/supabase-cli secrets set OPENROUTER_API_KEY=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

/tmp/supabase-cli functions deploy ai-generate