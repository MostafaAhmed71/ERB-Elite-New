# انسخ هذا الملف إلى .env واملأ القيم

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# رابط الموقع النهائي (لروابط QR وبطاقات الطلاب)
# التطوير المحلي:
VITE_APP_URL=http://localhost:5173
# الإنتاج:
# VITE_APP_URL=https://your-school-domain.com

# بيانات وهمية للوحة المتصدرين — false قبل النشر
VITE_LEADERBOARD_MOCK=false

# Web Push (G1) — المفتاح العام VAPID من npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# أسرار Edge Function send-web-push: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
